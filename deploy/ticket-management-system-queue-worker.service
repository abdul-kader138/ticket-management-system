[Unit]
Description=Ticket Management System queue supervisor (php artisan horizon)
After=network.target mysql.service redis-server.service

[Service]
Type=simple
# Matches deploy.sh's own WEB_USER/APP_DIR defaults. If those are ever
# overridden via env vars for a given deployment, update User/Group and
# WorkingDirectory/ExecStart below to match — this file is installed
# as-is by deploy.sh, not templated.
User=www-data
Group=www-data
WorkingDirectory=/var/www/ticket-management-system
# Horizon supervises its own pool of `queue:work redis` processes (sizing
# comes from config/horizon.php) and exposes /horizon for live queue
# depth, throughput and failed-job inspection — payment/booking/webhook
# jobs (see docs/ROADMAP.md) need that visibility from day one, a bare
# queue:work loop doesn't give it. `artisan horizon:terminate` (call from
# deploy.sh after a deploy) exits workers gracefully after their current
# job; Restart=always brings the master process straight back up.
ExecStart=/usr/bin/php /var/www/ticket-management-system/artisan horizon
ExecStop=/usr/bin/php /var/www/ticket-management-system/artisan horizon:terminate
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
